[Unit]
Description=Deliver unverified Partners task reports to CRM
ConditionPathExists=/etc/the-affiliates-partners/runtime-user-ready
After=network-online.target the-affiliates-partners-api.service
Wants=network-online.target

[Service]
Type=oneshot
User=ta-partners
Group=ta-partners
WorkingDirectory=/opt/the-affiliates-partners
ExecStart=/usr/bin/flock -n /run/lock/the-affiliates-partners-task-reports.lock /usr/bin/python3 -m server.task_report_delivery
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
UMask=0077
LimitCORE=0
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
