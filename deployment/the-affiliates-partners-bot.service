[Unit]
Description=The Affiliates Partners fresh Telegram bot
After=network-online.target the-affiliates-partners-api.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/the-affiliates-partners
ExecStart=/usr/bin/python3 -m server.bot
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
