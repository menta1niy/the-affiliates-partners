[Unit]
Description=The Affiliates Partners Telegram bot polling
After=network-online.target the-affiliates-partners-api.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/the-affiliates-partners
ExecStart=/usr/bin/python3 /opt/the-affiliates-partners/server/bot.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
