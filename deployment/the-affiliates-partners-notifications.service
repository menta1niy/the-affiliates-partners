[Unit]
Description=Dispatch pending The Affiliates Partners Telegram notifications
After=network-online.target the-affiliates-partners-api.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/the-affiliates-partners
ExecStart=/usr/bin/flock -n /run/lock/the-affiliates-partners-notifications.lock /usr/bin/python3 -m tools.dispatch_notifications
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
