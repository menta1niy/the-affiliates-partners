[Unit]
Description=The Affiliates Partners fresh API
ConditionPathExists=/etc/the-affiliates-partners/runtime-user-ready
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ta-partners
Group=ta-partners
WorkingDirectory=/opt/the-affiliates-partners
ExecStart=/usr/bin/python3 -m server.api
Environment=SERVER_PORT=8788
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
UMask=0077
LimitCORE=0
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
