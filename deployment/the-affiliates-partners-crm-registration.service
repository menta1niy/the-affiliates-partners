[Unit]
Description=Dispatch consented Partners registrations to CRM
After=network-online.target the-affiliates-partners-api.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/the-affiliates-partners
ExecStart=/usr/bin/flock -n /run/lock/the-affiliates-partners-crm-registration.lock /usr/bin/python3 -m server.crm_registration
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
UMask=0077
LimitCORE=0
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
